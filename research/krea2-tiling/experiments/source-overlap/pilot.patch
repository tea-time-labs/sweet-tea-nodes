+    def test_source_matched_overlap_uses_one_early_writer_and_releases_it(self):
+        from usdu_pose_tiled.krea2_overlap import SourceMatchedVision
+        from usdu_pose_tiled.krea2_vision import Tile
+
+        # The two windows straddle a source feature. The upper model wants to
+        # move it high, and the lower model predicts its original placement.
+        tiles = [Tile(0, 24, 0, 16, torch.ones(24, 16)),
+                 Tile(8, 32, 0, 16, torch.ones(24, 16))]
+        source = torch.zeros(1, 2, 1, 32, 16)
+        source[..., 18:20, 4:12] = 1
+        options = {"cond_or_uncond": [0], "sample_sigmas": torch.tensor([1., .5, 0.])}
+        wrapper = SourceMatchedVision(tiles, [torch.zeros(1, 1, 1), torch.ones(1, 1, 1)],
+                                      2, 32, 16, source)
+        x = torch.zeros_like(source)
+        calls = []
+        def predict(tile, sigma, cond, mask, refs, opts):
+            i = cond.item()
+            calls.append(i)
+            clean = source[tiles[i].region].clone()
+            if i == 0:
+                clean = clean.roll(-5, dims=-2)
+            return -clean / sigma
+
+        with patch.object(sys.modules["comfy.model_management"],
+                          "throw_exception_if_processing_interrupted", lambda: None, create=True):
+            early = wrapper(predict, x, torch.tensor([1.]), torch.tensor(0), transformer_options=options)
+            late = wrapper(predict, x, torch.tensor([.5]), torch.tensor(0), transformer_options=options)
+        self.assertEqual(calls, [0, 1, 0, 1])
+        self.assertEqual(wrapper.choices[0][2], 1)
+        self.assertTrue(torch.all(early[..., 13, 7] == 0))
+        self.assertTrue(torch.all(early[..., 18, 7] == -1))
+        self.assertTrue(torch.all(late[..., 13, 7] == -1))
+        self.assertTrue(torch.all(late[..., 18, 7] == -1))
+
+    def test_source_scores_preserve_the_blend_on_ties_and_normalize_four_way_junctions(self):
+        from usdu_pose_tiled.krea2_overlap import matched_tiles
+        from usdu_pose_tiled.krea2_vision import _tiles
+
+        tiles = _tiles(256, 256, 128, 128, 48, 2)
+        total = torch.zeros(32, 32)
+        for tile in tiles:
+            total[tile.region] += tile.weight
+        ties = [torch.ones_like(t.weight) for t in tiles]
+        same, choices = matched_tiles(tiles, total, ties)
+        self.assertTrue(all(owner is None for _, _, owner in choices))
+        self.assertTrue(all(torch.equal(t.weight, n.weight) for t, n in zip(tiles, same)))
+        scores = [v * (i+1) for i, v in enumerate(ties)]
+        selected, choices = matched_tiles(tiles, total, scores)
+        self.assertTrue(any(len(errors) == 4 and owner == 0 for _, errors, owner in choices))
+        check = torch.zeros_like(total)
+        for tile in selected:
+            check[tile.region] += tile.weight
+        self.assertTrue(torch.allclose(total, check, atol=1e-6))
+        self.assertEqual(float(selected[0].weight[16, 16]), float(total[16, 16]))
+
     def test_vision_rejects_text_only_tokenizer_output(self):
